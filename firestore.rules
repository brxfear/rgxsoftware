rules_version = '2';

// RGX Software — Firestore güvenlik kuralları
//
// Koleksiyonlar:
//   categories, products        herkes okur, sadece yönetici yazar (loglu)
//   orders                      müşteri "onay bekliyor" sipariş açar; yönetici okur / günceller (loglu)
//   carts/{uid}/items           sadece sahibi
//   admins/{sha256(e-posta)}    yönetici listesi — e-posta saklanmaz, sadece özeti; { nickname, ... }
//   admin_logs/{id}             yönetici işlem kayıtları — sadece eklenir, asla değiştirilmez/silinmez
//   payment_logs/{id}           Shopier ödeme olayları — sadece sunucu yazar
//   settings/{id}               site ayarları (IBAN vb.)
//   license_keys/{id}           key stoğu — sadece yöneticiler okur/yazar (loglu), asla silinmez
//
// Log zorunluluğu: yöneticinin her yazma işlemi aynı batch içinde bir admin_logs kaydı oluşturmak
// ZORUNDADIR. Hedef belgenin last_log_id alanı o kayda işaret eder; silmede kayıt kimliği
// "del_" + last_log_id (yoksa "del_" + belge id) olur. Log'suz yazma reddedilir.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- Yönetici kimliği ----------
    function googleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && ('email' in request.auth.token)
        && request.auth.token.get('email_verified', false) == true;
    }

    function myAdminId() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    function adminPath(id) {
      return /databases/$(database)/documents/admins/$(id);
    }

    function isAdmin() {
      return googleUser() && exists(adminPath(myAdminId()));
    }

    function myNick() {
      return get(adminPath(myAdminId())).data.nickname;
    }

    function validNick(n) {
      return n is string && n.size() >= 2 && n.size() <= 24;
    }

    // ---------- Zorunlu log ----------
    function logPath(id) {
      return /databases/$(database)/documents/admin_logs/$(id);
    }

    // Oluşturma / güncelleme: belge last_log_id ile bu istekte yazılan log'a işaret etmeli.
    function loggedWrite(targetId) {
      let log = getAfter(logPath(request.resource.data.last_log_id));
      return log.data.target_id == targetId
        && log.data.actor_uid == request.auth.uid
        && log.data.at == request.time;
    }

    // Silme: "del_" + mevcut last_log_id (yoksa belge id) kimlikli log aynı istekte yazılmalı.
    function loggedDelete(targetId) {
      let log = getAfter(logPath('del_' + resource.data.get('last_log_id', targetId)));
      return log.data.target_id == targetId
        && log.data.action == 'delete'
        && log.data.actor_uid == request.auth.uid
        && log.data.at == request.time;
    }

    // Toplu işlemler (ör. 50 key ekleme): belgeler aynı istekte yazılmış tek bir log'a işaret eder.
    function batchLogged() {
      let log = getAfter(logPath(request.resource.data.last_log_id));
      return log.data.actor_uid == request.auth.uid && log.data.at == request.time;
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actor_uid', 'actor_nick', 'action', 'target_type', 'target_id', 'summary', 'at'])
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.actor_nick == myNick()
        && request.resource.data.action in ['create', 'update', 'delete', 'status', 'login']
        && request.resource.data.target_type in ['product', 'category', 'order', 'admin', 'session', 'settings', 'key']
        && request.resource.data.target_id is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------- Yöneticiler ----------
    match /admins/{id} {
      allow read: if isAdmin() || (googleUser() && id == myAdminId());
      allow create: if isAdmin()
        && id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['nickname', 'added_by_nick', 'created_at', 'last_log_id'])
        && validNick(request.resource.data.nickname)
        && request.resource.data.added_by_nick == myNick()
        && request.resource.data.created_at == request.time
        && loggedWrite(id);
      // Herkes sadece kendi takma adını değiştirebilir.
      allow update: if isAdmin()
        && id == myAdminId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'last_log_id'])
        && validNick(request.resource.data.nickname)
        && loggedWrite(id);
      // Kimse kendini çıkaramaz (panel yöneticisiz kalmasın).
      allow delete: if isAdmin() && id != myAdminId() && loggedDelete(id);
    }

    // ---------- Mağaza ----------
    match /categories/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && loggedWrite(id);
      allow delete: if isAdmin() && loggedDelete(id);
    }

    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && loggedWrite(id);
      allow delete: if isAdmin() && loggedDelete(id);
    }

    match /orders/{id} {
      // Havale / kripto siparişi: müşteri sadece "onay bekliyor" durumunda oluşturabilir.
      // Kartla ödeme siparişleri sunucuda (Admin SDK) oluşturulur ve bu kurallara takılmaz.
      allow create: if request.resource.data.status == 'Waiting for Confirmation'
        && !('last_log_id' in request.resource.data)
        && request.resource.data.total_amount is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && (
          (signedIn() && request.resource.data.user_id == request.auth.uid)
          || (!signedIn() && request.resource.data.user_id == null)
        );
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() && loggedWrite(id);
      allow delete: if isAdmin() && loggedDelete(id);
    }

    // Ödeme logları: sadece sunucu (Admin SDK) yazar, yöneticiler okur.
    match /payment_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Site ayarları (ör. settings/payment: IBAN bilgileri) — herkes okur, yönetici loglu yazar.
    match /settings/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && loggedWrite(id);
      allow delete: if false;
    }

    // Key stoğu: { product_id, plan_id, key, status: available|used|removed, order_id, … }
    match /license_keys/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && batchLogged()
        && request.resource.data.status == 'available'
        && request.resource.data.key is string
        && request.resource.data.key.size() > 0
        && request.resource.data.key.size() <= 2000;
      allow update: if isAdmin() && batchLogged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'order_id', 'used_at', 'last_log_id']);
      allow delete: if false;
    }

    match /carts/{uid}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
