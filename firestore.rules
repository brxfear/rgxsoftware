rules_version = '2';

// RGX Software — Firestore güvenlik kuralları
// Koleksiyonlar: categories, products, orders, carts/{uid}/items, admins/{uid}
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = admins/{uid} veya admins/{doğrulanmış e-posta} belgesi olan kullanıcı.
    // Bu belgeleri sadece konsol / Admin SDK ekler.
    function verifiedEmail() {
      return ('email' in request.auth.token) && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (verifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    match /admins/{id} {
      allow read: if signedIn() && (request.auth.uid == id || (verifiedEmail() && request.auth.token.email == id));
      allow write: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      // Havale / kripto siparişi: müşteri sadece "onay bekliyor" durumunda oluşturabilir.
      // Kartla ödeme siparişleri sunucuda (Admin SDK) oluşturulur ve bu kurallara takılmaz.
      allow create: if request.resource.data.status == 'Waiting for Confirmation'
        && request.resource.data.total_amount is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && (
          (signedIn() && request.resource.data.user_id == request.auth.uid)
          || (!signedIn() && request.resource.data.user_id == null)
        );
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /carts/{uid}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
