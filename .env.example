# --- İstemci (Vite) — Firebase konsolu > Proje ayarları > Web uygulaması ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rgxsoftware.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rgxsoftware
VITE_FIREBASE_STORAGE_BUCKET=rgxsoftware.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Sunucu (sadece Vercel ortam değişkenleri, VITE_ öneki YOK) ---
# Firebase konsolu > Proje ayarları > Hizmet hesapları > Yeni özel anahtar oluştur (JSON'u tek satır yapıştır)
FIREBASE_SERVICE_ACCOUNT=
# Shopier REST API Personal Access Token — Shopier panel > Geliştirici > Kişisel Erişim Anahtarı
# (ödeme ürünü oluşturma, sipariş okuma, webhook)
SHOPIER_PAT=
# (opsiyonel) Shopier ödeme ürünlerinde kullanılacak jpg/png görsel URL'si
SHOPIER_PRODUCT_IMAGE=
SITE_URL=https://alanadin.com
