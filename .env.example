# --- İstemci (Vite) — Firebase konsolu > Proje ayarları > Web uygulaması ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rgxsoftware.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rgxsoftware
